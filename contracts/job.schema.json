{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusOS Job",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "requestedBy",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "planned",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "requestedBy": {
      "type": "string"
    },
    "assignedAgent": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlationId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
